# ==============================================================================
# Smart Legal Aid Assistance - Environment Configuration Template
# ==============================================================================

# LLM Provider Configuration (Primary: grok)
LLM_PROVIDER=grok
GROK_API_KEY=your_grok_xai_api_key_here
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1

# Alternative LLM Providers (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# ChromaDB Vector Database Configuration (Cloud or Local)
VECTOR_DB_TYPE=chroma
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_id_here
CHROMA_DATABASE=legal

# Authentication & JWT
JWT_SECRET_KEY=smart-legal-aid-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# NoSQL Database Configuration (MongoDB + Embedded TinyDB fallback)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=legal_aid_db
NOSQL_BACKEND=auto

# Server Configuration
HOST=0.0.0.0
PORT=8000
